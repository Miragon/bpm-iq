# bpmiq Live Host — environment reference (docker-compose reads this via env_file).
# Every variable the server reads (composition root: apps/live-host/src/server.ts).
# Copy to .env, uncomment what you need. Defaults shown are the code's defaults.

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED in production: the public origin users reach. The IdP callback
# (<url>/auth/oidc/callback), the webhook receiver (<url>/webhook/github) and
# Secure cookies all derive from it. With TLS termination (caddy) this is the
# https URL. Default: http://localhost:<PORT> — dev only.
LIVE_PUBLIC_URL=https://bpm.example.com

# PORT is pinned to 8080 IN the container by the image — do not set it here;
# map the host port in docker-compose.yml ("8301:8080") instead.
#PORT=8080

# Host-owned state (live.db, workspace clones). The image sets /data — mount a
# volume there (compose: ./data:/data) and leave this unset.
#LIVE_DATA_DIR=/data

# ── GitHub App — multi-repo mode ─────────────────────────────────────────────
# With app credentials the connected-repo set derives from the App's
# installations (repo overview, on-demand clones, app-side authorization).
GITHUB_APP_ID=
# Public app slug (not a secret) — enables app mode + the install-picker URL.
GITHUB_APP_SLUG=

# App private key — first match wins:
#   GITHUB_APP_PRIVATE_KEY       raw PEM (quote it; multi-line is fine)
#   GITHUB_APP_PRIVATE_KEY_FILE  path to a mounted .pem
#   GITHUB_APP_PRIVATE_KEY_B64   base64 one-liner — the compose-friendly variant
GITHUB_APP_PRIVATE_KEY_B64=
#GITHUB_APP_PRIVATE_KEY_FILE=/data/app.pem
#GITHUB_APP_PRIVATE_KEY=

# Verifies installation-lifecycle webhooks at POST /webhook/github (HMAC).
GITHUB_WEBHOOK_SECRET=

# Webhook URL written into the App manifest by `pnpm create-app` — defaults to
# ${LIVE_PUBLIC_URL}/webhook/github when the host is publicly reachable.
#LIVE_WEBHOOK_URL=

# Fallback single repo when NO app credentials are configured (static registry
# entry instead of installation enumeration), and its base branch.
#GITHUB_REPO=my-org/my-processes
#BASE_BRANCH=main

# ── GitHub Enterprise ────────────────────────────────────────────────────────
# Point both at your GHE instance (or at test/stub-provider.ts for offline dev).
#GITHUB_BASE_URL=https://github.com
#GITHUB_API_URL=https://api.github.com

# ── OIDC — the login (browser SSO + bearer JWTs, one identity contract) ──────
# Your identity provider (Keycloak / WorkOS / Entra / Auth0, …) is the ONE
# login (ADR 0007): the web app and editors run its code+PKCE flow, MCP and
# headless clients present its audience-bound JWTs. The host only VERIFIES
# tokens (resource server) — it never runs its own authorization server; per-
# repo authorization runs app-side against real GitHub permissions. In
# LIVE_AUTH=oidc all three of ISSUER, JWKS_URL and CLIENT_ID are required.
# The values below are the Keycloak quickstart's (docs/on-prem/idp-quickstart.md,
# `docker compose --profile keycloak up -d`); keep the realm, swap the URLs.
#LIVE_OIDC_ISSUER=http://localhost:8080/realms/bpmiq
# JWKS + token endpoint as reached FROM THE CONTAINER (the compose network);
# the issuer and authorize URL stay what the browser sees.
#LIVE_OIDC_JWKS_URL=http://keycloak:8080/realms/bpmiq/protocol/openid-connect/certs
#LIVE_OIDC_CLIENT_ID=bpmiq-web
#LIVE_OIDC_AUTHORIZE_URL=http://localhost:8080/realms/bpmiq/protocol/openid-connect/auth
#LIVE_OIDC_TOKEN_URL=http://keycloak:8080/realms/bpmiq/protocol/openid-connect/token
# Audience the tokens must be bound to. Default: LIVE_PUBLIC_URL; the quickstart
# realm mints the fixed audience "bpmiq" (Keycloak has no RFC 8707).
#LIVE_OIDC_AUDIENCE=bpmiq
# Optional: confidential client secret (unset = public client, PKCE only), the
# login button's label, the claim carrying the IdP-verified GitHub login
# (IdP-populated, never user-editable; tokens without it are refused).
#LIVE_OIDC_CLIENT_SECRET=
#LIVE_OIDC_LOGIN_LABEL=Keycloak
#LIVE_OIDC_LOGIN_CLAIM=github_login
# 1 = the MCP endpoint registers no write tools (read-only).
#LIVE_MCP_READONLY=

# ── Security & limits ────────────────────────────────────────────────────────
# HMAC key for the browser-bound login state, so a restart mid-login keeps
# in-flight logins valid (the name predates ADR 0007 — nothing is encrypted
# any more, no credential is stored). Falls back to CELL_TOKEN_KEY; set it
# EXPLICITLY in production.
SESSION_ENC_KEY=

# Per-room document size cap in bytes (DoS guard, enforced at ingest + persist).
#LIVE_MAX_DOC_BYTES=8000000
# WebSocket connection ceilings: global and per client IP.
#LIVE_MAX_WS=400
#LIVE_MAX_WS_PER_IP=40
# Shutdown hard-exit in ms — time to flush debounced write-throughs on SIGTERM.
# Must stay BELOW the container's stop grace period (compose: 30s).
#LIVE_SHUTDOWN_MS=25000

# ── Authentication mode (ADR 0007) ───────────────────────────────────────────
# oidc (default): a login is required — the LIVE_OIDC_* block; the server
# refuses to start without one. none: NO authentication — every request is
# the local principal and every repository is writable. Local evaluation or a
# trusted single-team network only; never inferred from missing config.
#LIVE_AUTH=oidc
# LIVE_AUTH=none only: the local principal's login (use your GitHub login so
# release commits attribute to you; in a container the OS fallback is root).
#LIVE_LOCAL_USER=

# ── Dev only — never in production ───────────────────────────────────────────
# Serve local content for the fallback repo without a clone (dev checkout).
#LIVE_HOST_CONTENT_DIR=
# Offline/test escape hatches: rewrite clone/fetch and push remotes to local
# bare repos (see test/release-e2e.sh).
#LIVE_GIT_URL_OVERRIDE=
#LIVE_PUSH_URL_OVERRIDE=

# ── Cell mode — Miragon hosted operation only, leave unset on-prem ───────────
# ADR 0002: a cell serves ONE tenant, holds no App key, and gets installation
# tokens minted remotely by the control plane.
#TENANT_INSTALLATION_ID=
#TOKEN_MINT_URL=
#CELL_SECRET=
#CELL_TOKEN_KEY=
