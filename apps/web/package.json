    "@bpmiq/mcp-kit": "workspace:*",
    "@bpmiq/notations": "workspace:*",
    "@bpmiq/ui-kit": "workspace:*",
    "@emaarco/dmn-js-simulation": "0.2.0",
    "@miragon/context-maps-renderer": "0.1.0",
    "@miragon/context-maps-schema-model": "0.1.0",
    "@miragon/team-topologies-renderer": "0.6.0",
    "@miragon/team-topologies-schema-model": "0.6.0",
    "@miragon/wardley-renderer": "0.6.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.101.4",
