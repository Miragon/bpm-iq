{
  "name": "bpm-live",
  "displayName": "BPM Live Workspace",
  "description": "Open live model documents (bpm-live://) synced through the bpmiq Live Host — the Miragon BPMN Modeler opens them like any other file.",
  "version": "0.0.1",
  "private": true,
  "publisher": "miragon-gmbh",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onFileSystem:bpm-live",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bpmLive.open",
        "title": "BPM Live: Open Live Model"
      },
      {
        "command": "bpmLive.login",
        "title": "BPM Live: Sign in"
      },
      {
        "command": "bpmLive.loginWithToken",
        "title": "BPM Live: Sign in with a session token…"
      },
      {
        "command": "bpmLive.logout",
        "title": "BPM Live: Sign out"
      }
    ],
    "configuration": {
      "title": "BPM Live",
      "properties": {
        "bpmLive.serverUrl": {
          "type": "string",
          "default": "http://localhost:8301",
          "description": "URL of the Live Host — http(s):// or ws(s)://, both forms work."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=out/extension.js",
    "typecheck": "tsc -p .",
    "test": "node --test src/test/unit/*.test.ts",
    "test:e2e": "pnpm compile && esbuild src/test/e2e.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/test-e2e.js && node src/test/runTest.mts"
  },
  "dependencies": {
    "@bpmiq/contracts": "workspace:*",
    "@bpmiq/live-client": "workspace:*",
    "@hocuspocus/provider": "4.6.0",
    "ws": "8.21.3",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/vscode": "1.136.0",
    "@types/ws": "8.18.1",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
