{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run designIQ Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "design-iq: compile"
    }
  ]
}
