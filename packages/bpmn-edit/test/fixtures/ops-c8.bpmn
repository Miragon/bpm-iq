<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_ops" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="Process_OpsC8" isExecutable="true">
    <bpmn:startEvent id="startEvent_received" name="Order received">
      <bpmn:outgoing>flow_receivedToCheck</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="task_check" name="Check order">
      <bpmn:incoming>flow_receivedToCheck</bpmn:incoming>
      <bpmn:outgoing>flow_checkToOk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gateway_ok" name="Order ok?" default="flow_okNo">
      <bpmn:incoming>flow_checkToOk</bpmn:incoming>
      <bpmn:outgoing>flow_okYes</bpmn:outgoing>
      <bpmn:outgoing>flow_okNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="task_ship" name="Ship order">
      <bpmn:incoming>flow_okYes</bpmn:incoming>
      <bpmn:outgoing>flow_shipToShipped</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="endEvent_shipped" name="Order shipped">
      <bpmn:incoming>flow_shipToShipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="endEvent_rejected" name="Order rejected">
      <bpmn:incoming>flow_okNo</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_receivedToCheck" sourceRef="startEvent_received" targetRef="task_check" />
    <bpmn:sequenceFlow id="flow_checkToOk" sourceRef="task_check" targetRef="gateway_ok" />
    <bpmn:sequenceFlow id="flow_okYes" name="yes" sourceRef="gateway_ok" targetRef="task_ship">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ok = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_okNo" name="no" sourceRef="gateway_ok" targetRef="endEvent_rejected" />
    <bpmn:sequenceFlow id="flow_shipToShipped" sourceRef="task_ship" targetRef="endEvent_shipped" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Ops">
    <bpmndi:BPMNPlane id="Plane_Ops">
      <bpmndi:BPMNShape id="startEvent_received_di" bpmnElement="startEvent_received">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="133" y="145" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_di" bpmnElement="task_check">
        <dc:Bounds x="250" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gateway_ok_di" bpmnElement="gateway_ok" isMarkerVisible="true">
        <dc:Bounds x="425" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="425" y="65" width="50" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_di" bpmnElement="task_ship">
        <dc:Bounds x="550" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_shipped_di" bpmnElement="endEvent_shipped">
        <dc:Bounds x="752" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="145" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="endEvent_rejected_di" bpmnElement="endEvent_rejected">
        <dc:Bounds x="752" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="734" y="295" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_receivedToCheck_di" bpmnElement="flow_receivedToCheck">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="250" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_checkToOk_di" bpmnElement="flow_checkToOk">
        <di:waypoint x="350" y="120" />
        <di:waypoint x="425" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_okYes_di" bpmnElement="flow_okYes">
        <di:waypoint x="475" y="120" />
        <di:waypoint x="550" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="504" y="102" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_okNo_di" bpmnElement="flow_okNo">
        <di:waypoint x="450" y="145" />
        <di:waypoint x="450" y="270" />
        <di:waypoint x="752" y="270" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="458" y="200" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_shipToShipped_di" bpmnElement="flow_shipToShipped">
        <di:waypoint x="650" y="120" />
        <di:waypoint x="752" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
