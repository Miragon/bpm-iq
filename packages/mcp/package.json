{
  "name": "@miragon/design-iq-mcp",
  "version": "4.3.1",
  "description": "Read-only MCP server exposing a BPM content repo's processes — discovered from designiq.yml, derived from the BPMN — to any MCP client.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/design-iq.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "bpm",
    "bpmn",
    "dmn",
    "mcp",
    "model-context-protocol",
    "process-documentation"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "designiq-mcp-server": "server.ts"
  },
  "exports": {
    ".": "./server.ts",
    "./http": "./http.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/server.js",
      "./http": "./dist/http.js"
    },
    "bin": {
      "designiq-mcp-server": "dist/server.js"
    }
  },
  "scripts": {
    "start": "node server.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "fast-xml-parser": "5.11.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@designiq/contracts": "workspace:*",
    "@designiq/github-app": "workspace:*",
    "@designiq/http-kit": "workspace:*",
    "@designiq/mcp-kit": "workspace:*",
    "@designiq/notations": "workspace:*",
    "@modelcontextprotocol/client": "2.1.0",
    "tsdown": "0.23.0"
  }
}
