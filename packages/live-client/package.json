{
  "name": "@bpmiq/live-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared live-session client: the ONE Hocuspocus wiring (socket + provider + sync lifecycle) for the web editor, the VS Code extension and headless guests \u2014 plus minimal-diff Y.Text writing and the Y.Text \u2194 bpmn-js / dmn-js sync bridges.",
  "engines": {
    "node": ">=23.6"
  },
  "exports": {
    ".": "./src/session.ts",
    "./text": "./src/text-diff.ts",
    "./bpmn-sync": "./src/bpmn-sync.ts",
    "./dmn-sync": "./src/dmn-sync.ts",
    "./wardley-sync": "./src/wardley-sync.ts",
    "./tt-sync": "./src/tt-sync.ts",
    "./structured": "./src/structured.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.ts"
  },
  "dependencies": {
    "@bpmiq/contracts": "workspace:*",
    "@hocuspocus/provider": "4.6.0",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3"
  }
}
