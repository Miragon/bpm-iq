{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run BPM Live Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"],
      "outFiles": ["${workspaceFolder}/apps/vscode/out/**/*.js"],
      "sourceMaps": true,
      "preLaunchTask": "bpm-live: compile"
    }
  ]
}
